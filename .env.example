# Copiar a .env (no commitear). Ninguna variable es obligatoria para arrancar.
# La app funciona sin clave: Photon + OpenFreeMap + PVGIS no requieren API key.

# URL pública que ve el navegador (metadata, enlaces absolutos).
APP_URL=http://localhost:3001

# Puerto del host para Docker Compose. El contenedor escucha en 3000.
APP_PORT=3001

# Geocoder: "photon" (default, sin clave) o "google" (requiere clave).
GEOCODER_PROVIDER=photon

# Opcional. Solo se usa si GEOCODER_PROVIDER=google.
# Se lee en el servidor; nunca se expone con NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=
